{
	"tasks": {
		"dev": "cd src; python3 -m http.server 9000",
		"build": "deno --allow-read --allow-write --allow-env ci/build.js",
		"deploy": "deno --allow-read --allow-net --allow-env ci/deploy.js",
		"purge": "deno --allow-read --allow-net --allow-env ci/purge.js"
	},
	"imports": {
		"@std/dotenv": "jsr:@std/dotenv@^0.225.0",
		"@std/path": "jsr:@std/path@^1.1.0"
	},
	"lint": {
		"include": ["src/"],
		"rules": {
			"include": [],
			"exclude": ["no-window-prefix", "no-window"]
		}
	}
}